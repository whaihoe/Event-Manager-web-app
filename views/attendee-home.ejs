<!DOCTYPE html>
<html lang="en">
<%- include("partials/head", { title: "Attendee Dashboard" }) %>

<body>
<%- include("partials/navbar") %>

    <div class="container py-5">
        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold">
                Attendee Home Page
            </h1>
            <h2 class="h4 text-muted">
                <%= settings.site_name %>
            </h2>

            <p class="lead text-muted">
                <%= settings.site_description %>
            </p>

            <p class="text-muted">
                Welcome, <%= userName %>. Browse available events and buy tickets for the ones you are interested in.
            </p>
        </div>


        <%- include("events/partials/event-list",{
            publishedEvents: publishedEvents,
            role: role,
            actionText: "View Event Details"
        }) %>
    </div>
</body>
</html>
