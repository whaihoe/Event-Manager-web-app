<!DOCTYPE html>
<html lang="en">
<%- include("partials/head", { title: "Attendee Dashboard" }) %>

<body>
<%- include("partials/navbar") %>

    <main class="container page-shell py-5">
        <section class="dashboard-hero">
            <p class="eyebrow">Attendee Dashboard</p>
            <h1 class="page-title">
                Find events worth showing up for.
            </h1>

            <p class="page-subtitle">
                <%= settings.site_description %>
            </p>

            <p class="text-muted mb-0 mt-3">
                Welcome, <%= userName %>. Browse available events and buy tickets for the ones you are interested in.
            </p>
        </section>


        <%- include("events/partials/event-list",{
            publishedEvents: publishedEvents,
            role: role,
            actionText: "View Event Details"
        }) %>
    </main>
</body>
</html>
