<!DOCTYPE html>
<html lang="en">
<%- include("partials/head", { title: "Attendee Dashboard" }) %>

<body>
<%- include("partials/navbar") %>

<div class="container py-5">
  <div class="text-center mb-5">
    <h1 class="display-4 fw-bold">
      Attendee Dashboard
    </h1>

    <p class="lead text-muted">
      Welcome, <%= userName %>. Browse available events and buy tickets for the ones you are interested in.
    </p>
  </div>

  <div class="row g-4 justify-content-center">
    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body text-center">
          <h3 class="card-title mb-3">
            Browse Events
          </h3>

          <p class="card-text text-muted">
            View published events posted by organisers.
          </p>

          <a href="/events" class="btn btn-dark">
            View Events
          </a>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body text-center">
          <h3 class="card-title mb-3">
            My Role
          </h3>

          <p class="card-text text-muted">
            Your account can view events and buy tickets, but cannot post them.
          </p>

          <button class="btn btn-outline-secondary" type="button" disabled>
            Attendee
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
