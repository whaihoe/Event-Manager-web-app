<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Event Manager</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
</head>

<body>

<%- include("partials/navbar") %>

<div class="container py-5">

  <div class="text-center mb-5">
    <h1 class="display-4 fw-bold">
      <% if (role === "organiser") { %>
        Organiser Dashboard
      <% } else { %>
        Participant Dashboard
      <% } %>
    </h1>

    <p class="lead text-muted">
      Welcome, <%= userName %>.
      <% if (role === "organiser") { %>
        Create and post events for participants to join.
      <% } else { %>
        Browse available events and join the ones you are interested in.
      <% } %>
    </p>
  </div>

  <div class="row g-4 justify-content-center">

    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body text-center">

          <% if (role === "organiser") { %>
            <h3 class="card-title mb-3">
              Create Events
            </h3>

            <p class="card-text text-muted">
              Post event details so participants can discover and join them.
            </p>

            <a href="/events/new" class="btn btn-dark">
              Create Event
            </a>
          <% } else { %>
            <h3 class="card-title mb-3">
              Browse Events
            </h3>

            <p class="card-text text-muted">
              View upcoming events posted by organisers.
            </p>

            <a href="/events" class="btn btn-dark">
              View Events
            </a>
          <% } %>

        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body text-center">

          <h3 class="card-title mb-3">
            <% if (role === "organiser") { %>
              Posted Events
            <% } else { %>
              Join Events
            <% } %>
          </h3>

          <p class="card-text text-muted">
            <% if (role === "organiser") { %>
              Review the events you have posted for participants.
            <% } else { %>
              Join events and keep track of your attendance.
            <% } %>
          </p>

          <a href="/events" class="btn btn-dark">
            View Events
          </a>

        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body text-center">

          <h3 class="card-title mb-3">
            <% if (role === "organiser") { %>
              Participants
            <% } else { %>
              My Role
            <% } %>
          </h3>

          <p class="card-text text-muted">
            <% if (role === "organiser") { %>
              Participants can view and join your posted events.
            <% } else { %>
              Your account can view and join events, but cannot post them.
            <% } %>
          </p>

          <button class="btn btn-outline-secondary" type="button" disabled>
            <% if (role === "organiser") { %>
              Organiser
            <% } else { %>
              Participant
            <% } %>
          </button>

        </div>
      </div>
    </div>

  </div>
</div>
</body>
</html>
