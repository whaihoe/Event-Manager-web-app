<!DOCTYPE html>
<html lang="en">
<%- include("partials/head", { title: settings.site_name }) %>

<body>
  <%- include("partials/navbar") %>

  <div class="container py-5">
    <div class="text-center mb-5">
      <h1 class="display-4 fw-bold">
        <%= settings.site_name %>
      </h1>

      <p class="lead text-muted">
        <%= settings.site_description %>
      </p>
    </div>

    <div class="row g-4 justify-content-center">
      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center">
            <h2 class="h4 card-title mb-3">
              Organiser
            </h2>

            <p class="card-text text-muted">
              Create, manage and publish events.
            </p>

            <a href="/organiser/home" class="btn btn-dark">
              Organiser Home
            </a>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm h-100">
          <div class="card-body text-center">
            <h2 class="h4 card-title mb-3">
              Attendee
            </h2>

            <p class="card-text text-muted">
              Browse published events and buy tickets.
            </p>

            <a href="/attendee/home" class="btn btn-dark">
              Attendee Home
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>

</html>