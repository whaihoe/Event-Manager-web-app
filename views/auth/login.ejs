<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet"  type="text/css" href="/main.css" />
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <title>Add User</title>
</head>
<body>
    <%- include("../partials/navbar") %>
    <div class="mx-5 mt-3" >
        <h1>Login</h1>
        <% if (error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
        <% } %>
        <form action="login" method="post">
            <!-- <p>Username: <input id="user_name" type="text" name="user_name" /></p> -->
            <p >Email: <input id="email_address" class="form-control" type="text" name="email_address" /></p>
            <p>Password: <input id="password" class="form-control" type="password" name="password" /></p>
            <button type="submit" class="btn btn-primary">Login</button>
        </form>
    </div>
</body>
</html>
