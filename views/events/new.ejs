<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet"  type="text/css" href="/main.css" />
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <title>Create Event</title>
</head>
<body>
    <%- include("../partials/navbar") %>
    <div class="container py-4">
        <h1>Create Event</h1>
        <form action="/events" method="post" novalidate>
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input
                    id="title"
                    class="form-control <%= errors.title ? 'is-invalid' : '' %>"
                    type="text"
                    name="title"
                    value="<%= formData.title || '' %>"
                />
                <% if (errors.title) { %>
                    <div class="invalid-feedback">
                        <%= errors.title %>
                    </div>
                <% } %>
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea
                    id="description"
                    class="form-control"
                    name="description"
                    rows="4"
                ><%= formData.description || '' %></textarea>
            </div>
            <div class="mb-3">
                <label for="event_date" class="form-label">Date</label>
                <input
                    id="event_date"
                    class="form-control <%= errors.event_date ? 'is-invalid' : '' %>"
                    type="date"
                    name="event_date"
                    value="<%= formData.event_date || '' %>"
                />
                <% if (errors.event_date) { %>
                    <div class="invalid-feedback">
                        <%= errors.event_date %>
                    </div>
                <% } %>
            </div>
            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input
                    id="location"
                    class="form-control <%= errors.location ? 'is-invalid' : '' %>"
                    type="text"
                    name="location"
                    value="<%= formData.location || '' %>"
                />
                <% if (errors.location) { %>
                    <div class="invalid-feedback">
                        <%= errors.location %>
                    </div>
                <% } %>
            </div>
            <button type="submit" class="btn btn-primary">Post Event</button>
            <a href="/events" class="btn btn-link">Cancel</a>
        </form>
    </div>
</body>
</html>
