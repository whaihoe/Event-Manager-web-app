<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head", { title: "Create Event" }) %>
<body>
    <%- include("../partials/navbar") %>
    <div class="container py-4">
        <h1>Create Event</h1>
        <form action="/events" method="post" novalidate>
            <%- include("partials/event-form-fields", {
                errors: errors,
                formData: formData,
                showTicketIds: false,
                showSoldCount: false
            }) %>

            <button type="submit" class="btn btn-primary">Create Event</button>
            <a href="/events" class="btn btn-link">Cancel</a>
        </form>
    </div>
</body>
</html>
