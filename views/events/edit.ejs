<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head", { title: "Edit Event" }) %>
<body>
    <%- include("../partials/navbar") %>
    <main class="container app-shell py-4">
        <a href="/organiser/home" class="btn btn-link ps-0 mb-3 text-decoration-none">
            &lt; Back
        </a>
        <section class="app-hero mb-4">
            <p class="app-kicker">Event Management</p>
            <h1 class="app-title">Organiser Edit Event Page</h1>
            <p class="app-subtitle">
                Created at: <%= event.created_at %><br>
                Last modified at: <%= event.updated_at %>
            </p>
        </section>

        <form class="app-panel p-4" action="/events/<%= event.event_id %>/edit" method="post" novalidate>
            <%- include("partials/event-form-fields", {
                errors: errors,
                formData: formData,
                showTicketIds: true,
                showSoldCount: true
            }) %>

            <div class="app-actions">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <% if (event.status === "draft") { %>
                <button
                    type="submit"
                    class="btn btn-success"
                    name="publish_after_save"
                    value="1"
                >
                    Save and Publish Event
                </button>
                <% } %>
                <button
                    type="submit"
                    class="btn btn-danger"
                    formaction="/events/<%= event.event_id %>/delete"
                >
                    Delete Event
                </button>
                <a href="/organiser/home" class="btn btn-link">Back to Organiser Home Page</a>
            </div>
        </form>

        <div class="app-section-header">
            <h2>Attendees</h2>
        </div>

        <% if (!attendees || attendees.length === 0) { %>
            <div class="alert alert-info">
                No attendees have bought tickets for this event yet.
            </div>
        <% } else { %>
            <div class="app-table">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Tickets Bought</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% attendees.forEach(function(attendee) { %>
                            <tr>
                                <td><%= attendee.user_name %></td>
                                <td><%= attendee.email_address || "No email found" %></td>
                                <td><%= attendee.ticket_summary || "No tickets found" %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </main>
</body>
</html>
<%# ===== END OF MY CODE ===== %>
