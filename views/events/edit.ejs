<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head", { title: "Edit Event" }) %>
<body>
    <%- include("../partials/navbar") %>
    <div class="container py-4">
        <h1>Edit Event</h1>
        <form action="/events/<%= event.event_id %>/edit" method="post" novalidate>
            <%- include("partials/event-form-fields", {
                errors: errors,
                formData: formData,
                showTicketIds: true,
                showSoldCount: true
            }) %>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <% if (event.status === "draft") { %>
                <button
                    type="submit"
                    class="btn btn-success"
                    formaction="/events/<%= event.event_id %>/publish"
                >
                    Publish Event
                </button>
            <% } %>
            <button
                type="submit"
                class="btn btn-danger"
                formaction="/events/<%= event.event_id %>/delete"
            >
                Delete Event
            </button>
            <a href="/events" class="btn btn-link">Cancel</a>
        </form>

        <h2 class="mt-4">Attendees</h2>

        <% if (!participants || participants.length === 0) { %>
            <div class="alert alert-info">
                No attendees have bought tickets for this event yet.
            </div>
        <% } else { %>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Tickets Bought</th>
                        <th>Purchased At</th>
                    </tr>
                </thead>
                <tbody>
                    <% participants.forEach(function(participant) { %>
                        <tr>
                            <td><%= participant.user_name %></td>
                            <td><%= participant.email_address || "No email found" %></td>
                            <td><%= participant.ticket_summary || "No tickets found" %></td>
                            <td><%= participant.joined_at %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>
</body>
</html>
