<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head", { title: "Edit Event" }) %>
<body>
    <%- include("../partials/navbar") %>
    <div class="container py-4">
        <a href="/organiser/home" class="btn btn-link ps-0 mb-3 text-decoration-none">
            &lt; Back
        </a>
        <h1>Organiser Edit Event Page</h1>
        <p class="text-muted">
            Created at: <%= event.created_at %>
        </p>
        <p class="text-muted">
            Last modified at: <%= event.updated_at %>
        </p>

        <form action="/events/<%= event.event_id %>/edit" method="post" novalidate>
            <%- include("partials/event-form-fields", {
                errors: errors,
                formData: formData,
                showTicketIds: true,
                showSoldCount: true
            }) %>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <% if (event.status === "draft") { %>
                <button
                    type="submit"
                    class="btn btn-success"
                    name="publish_after_save"
                    value="1"
                >
                    Save and Publish Event
                </button>
            <% } %>
            <button
                type="submit"
                class="btn btn-danger"
                formaction="/events/<%= event.event_id %>/delete"
            >
                Delete Event
            </button>
            <a href="/organiser/home" class="btn btn-link">Back to Organiser Home Page</a>
        </form>

        <h2 class="mt-4">Attendees</h2>

        <% if (!attendees || attendees.length === 0) { %>
            <div class="alert alert-info">
                No attendees have bought tickets for this event yet.
            </div>
        <% } else { %>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Tickets Bought</th>
                    </tr>
                </thead>
                <tbody>
                    <% attendees.forEach(function(attendee) { %>
                        <tr>
                            <td><%= attendee.user_name %></td>
                            <td><%= attendee.email_address || "No email found" %></td>
                            <td><%= attendee.ticket_summary || "No tickets found" %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>
</body>
</html>
