<div class="d-flex justify-content-between align-items-center mt-5 mb-3">
    <h2 class="mb-0">Published Events</h2>

    <form method="get" action="/<%= currentUserRole %>/home">
        <label for="sort" class="form-label me-2">
            Sort by
        </label>

        <select
            id="sort"
            name="sort"
            class="form-select d-inline-block w-auto"
            onchange="this.form.submit()"
        >
            <option value="earliest" <%= sortOption === "earliest" ? "selected" : "" %>>
                Earliest event date
            </option>

            <option value="latest" <%= sortOption === "latest" ? "selected" : "" %>>
                Latest event date
            </option>
        </select>
    </form>
</div>

<% if (publishedEvents.length === 0) { %>
    <div class="alert alert-info">
        You do not have any published events.
    </div>
<% } %>

<div class="row g-3">
    <% publishedEvents.forEach(function(event) { %>
        <%- include("event-card", {
            event: event,
            role: role,
            actionText: "Manage Event"
        }) %>
    <% }) %>
</div>