<%# ===== START OF MY CODE ===== %>
<div class="mb-3">
    <label for="title" class="form-label">Title</label>
    <input
        id="title"
        class="form-control <%= errors.title ? 'is-invalid' : '' %>"
        type="text"
        name="title"
        value="<%= formData.title || '' %>"
    />
    <% if (errors.title) { %>
        <div class="invalid-feedback">
            <%= errors.title %>
        </div>
    <% } %>
</div>
<div class="mb-3">
    <label for="description" class="form-label">Description</label>
    <textarea
        id="description"
        class="form-control"
        name="description"
        rows="4"
    ><%= formData.description || '' %></textarea>
</div>

<div class="mb-3">
    <label for="event_date" class="form-label">Date</label>
    <input
        id="event_date"
        class="form-control <%= errors.event_date ? 'is-invalid' : '' %>"
        type="date"
        name="event_date"
        value="<%= formData.event_date || '' %>"
    />
    <% if (errors.event_date) { %>
        <div class="invalid-feedback">
            <%= errors.event_date %>
        </div>
    <% } %>
</div>

<div class="mb-3">
    <label for="location" class="form-label">Location</label>
    <input
        id="location"
        class="form-control <%= errors.location ? 'is-invalid' : '' %>"
        type="text"
        name="location"
        value="<%= formData.location || '' %>"
    />
    <% if (errors.location) { %>
        <div class="invalid-feedback">
            <%= errors.location %>
        </div>
    <% } %>
</div>

<h2>Tickets</h2>
<% if (errors.tickets) { %>
    <div class="alert alert-danger">
        <%= errors.tickets %>
    </div>
<% } %>

<div id="ticket_rows">
    <% (formData.tickets || [{ ticket_type: "", quantity_available: "", price: "" }]).forEach(function(ticket) { %>
        <div class="row g-2 mb-3 ticket-row">
            <% if (showTicketIds) { %>
                <input type="hidden" name="ticket_id" value="<%= ticket.ticket_id || '' %>" />
            <% } %>
            <input type="hidden" name="ticket_type" value="<%= ticket.ticket_type || '' %>" />

            <div class="col-md-4">
                <label class="form-label">Ticket type</label>
                <div class="form-control bg-light">
                    <%= ticket.ticket_type %>
                </div>
                <% if (showSoldCount && ticket.ticket_id) { %>
                    <div class="form-text">
                        Sold: <%= ticket.quantity_sold || 0 %> / <%= ticket.quantity_available || 0 %>
                    </div>
                <% } %>
            </div>

            <div class="col-md-4">
                <label class="form-label">Quantity</label>
                <input class="form-control" type="number" name="ticket_quantity" min="1" value="<%= ticket.quantity_available || '' %>" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Price</label>
                <input class="form-control" type="number" name="ticket_price" min="0" step="0.01" value="<%= ticket.price != null ? ticket.price : '' %>" />
            </div>
        </div>
    <% }) %>
</div>
<%# ===== END OF MY CODE ===== %>
