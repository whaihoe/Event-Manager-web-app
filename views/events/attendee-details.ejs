<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head", { title: "Event Details" }) %>
<body>
    <%- include("../partials/navbar") %>
    <div class="container py-4">
        <a href="/organiser/home" class="btn btn-link ps-0 mb-3 text-decoration-none">
            &lt; Back
        </a>
        <h1>Attendee Event Page</h1>
        <h2><%= event.title %></h2>


        <div class="mb-4">
            <p><strong>Date:</strong> <%= event.event_date %></p>
            <p><strong>Location:</strong> <%= event.location %></p>
            <p><strong>Organiser:</strong> <%= event.organiser_name %></p>
            <p><strong>Description:</strong></p>
            <p><%= event.description || "No description provided." %></p>
        </div>

        <h2>Tickets</h2>

        <% if (errors.tickets) { %>
            <div class="alert alert-danger">
                <%= errors.tickets %>
            </div>
        <% } %>

        <form action="/events/<%= event.event_id %>/purchase" method="post">
            <div class="mb-3">
                <label for="attendee_name" class="form-label">Attendee name</label>
                <input
                    id="attendee_name"
                    class="form-control <%= errors.attendee_name ? 'is-invalid' : '' %>"
                    type="text"
                    name="attendee_name"
                    value="<%= formData.attendee_name || currentUserName || '' %>"
                />
                <% if (errors.attendee_name) { %>
                    <div class="invalid-feedback">
                        <%= errors.attendee_name %>
                    </div>
                <% } %>
            </div>

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Ticket Type</th>
                        <th>Price</th>
                        <th>Available</th>
                        <th>Your Tickets</th>
                        <th>Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    <% tickets.forEach(function(ticket) { %>
                        <% const remainingTickets = ticket.quantity_available - ticket.quantity_sold; %>
                        <tr>
                            <td><%= ticket.ticket_type %></td>
                            <td>$<%= ticket.price %></td>
                            <td><%= remainingTickets %></td>
                            <td><%= ticket.quantity_bought || 0 %></td>
                            <td>
                                <input
                                    class="form-control"
                                    type="number"
                                    name="ticket_<%= ticket.ticket_id %>"
                                    min="0"
                                    max="<%= remainingTickets %>"
                                    value="<%= formData['ticket_' + ticket.ticket_id] || 0 %>"
                                />
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <button type="submit" class="btn btn-primary">Book Tickets</button>
            <a href="/attendee/home" class="btn btn-link">Back</a>
        </form>
    </div>
</body>
</html>
