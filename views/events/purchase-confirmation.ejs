<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head", { title: "Purchase Confirmed" }) %>
<body>
    <%- include("../partials/navbar") %>
    <main class="container app-shell py-4">
        <div class="alert alert-success">
            Your ticket purchase has been confirmed.
        </div>

        <section class="app-hero mb-4">
            <p class="app-kicker">Purchase Confirmed</p>
            <h1 class="app-title"><%= purchase.title %></h1>

            <p><strong>Attendee:</strong> <%= purchase.attendee_name %></p>
            <p><strong>Date:</strong> <%= purchase.event_date %></p>
            <p><strong>Location:</strong> <%= purchase.location %></p>
            <p><strong>Organiser:</strong> <%= purchase.organiser_name %></p>
        </section>

        <h2>Tickets Purchased</h2>
        <div class="app-table mb-3">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Ticket Type</th>
                        <th>Quantity</th>
                        <th>Price Each</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <% purchase.tickets.forEach(function (ticket) { %>
                        <tr>
                            <td><%= ticket.ticket_type %></td>
                            <td><%= ticket.quantity %></td>
                            <td>$<%= ticket.price %></td>
                            <td>$<%= ticket.price * ticket.quantity %></td>
                        </tr>
                    <% }) %>
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3">Total</th>
                        <th>$<%= totalPrice %></th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <a href="/events/<%= purchase.event_id %>" class="btn btn-primary">Back to Event</a>
        <a href="/attendee/home" class="btn btn-link">Attendee Home</a>
    </main>
</body>
</html>
