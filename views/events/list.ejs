<!DOCTYPE html>
<html lang="en">
<%- include("../partials/head", { title: "Events" }) %>
<body>
    <%- include("../partials/navbar") %>
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-1">Events</h1>
                <p class="text-muted mb-0">
                    <% if (role === "organiser") { %>
                        Manage your draft and published events.
                    <% } else { %>
                        View published events and choose tickets.
                    <% } %>
                </p>
            </div>
            <% if (role === "organiser") { %>
                <form action="/events/new-draft" method="post">
                    <button type="submit" class="btn btn-primary">
                        Create New Event
                    </button>
                </form>
            <% } %>
        </div>

        <% if (role === "organiser") { %>
            <h2>Draft Events</h2>

            <% if (draftEvents.length === 0) { %>
                <div class="alert alert-info">
                    You do not have any draft events.
                </div>
            <% } %>

            <div class="row g-3 mb-5">
                <% draftEvents.forEach(function(event) { %>
                    <%- include("partials/event-card", {
                        event: event,
                        role: role,
                        actionText: "Manage Draft"
                    }) %>
                <% }) %>
            </div>

            <h2>Published Events</h2>

            <% if (publishedEvents.length === 0) { %>
                <div class="alert alert-info">
                    You do not have any published events.
                </div>
            <% } %>

            <div class="row g-3">
                <% publishedEvents.forEach(function(event) { %>
                    <%- include("partials/event-card", {
                        event: event,
                        role: role,
                        actionText: "Manage Event"
                    }) %>
                <% }) %>
            </div>
        <% } else { %>
            <% if (events.length === 0) { %>
                <div class="alert alert-info">
                    No published events are available yet.
                </div>
            <% } %>

            <div class="row g-3">
                <% events.forEach(function(event) { %>
                    <%- include("partials/event-card", {
                        event: event,
                        role: role,
                        actionText: ""
                    }) %>
                <% }) %>
            </div>
        <% } %>
    </div>
</body>
</html>
