<!DOCTYPE html>
<html lang="en">
<%- include("partials/head", { title: "Organiser Home Page" }) %>

<body>
    <%- include("partials/navbar") %>

    <main class="container page-shell py-5">
        <section class="dashboard-hero">
            <p class="eyebrow">Organiser Dashboard</p>
            <h1 class="page-title">
                Plan events, publish tickets and track attendees.
            </h1>

            <p class="page-subtitle">
                <%= settings.site_description %>
            </p>

            <p class="text-muted mb-0 mt-3">
                Welcome, <%= userName %>. Create and post events for attendees to buy tickets.
            </p>
        </section>

        <div class="row g-4 justify-content-center">
            <div class="col-md-4 mt-0">
                <div class="card action-card shadow-sm h-100">
                    <div class="card-body text-center">
                        <h3 class="card-title mb-3">
                            Create Events
                        </h3>

                        <p class="card-text text-muted">
                            Post event details so attendees can discover them and buy tickets.
                        </p>

                        <form action="/events/new-draft" method="post">
                            <button type="submit" class="btn btn-dark">
                                Create New Event
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mt-0">
                <div class="card action-card shadow-sm h-100">
                    <div class="card-body text-center">
                        <h3 class="card-title mb-3">
                            Attendees
                        </h3>

                        <p class="card-text text-muted">
                            Attendees can view your posted events and buy tickets.
                        </p>

                        <button class="btn btn-outline-secondary" type="button" disabled>
                            Organiser
                        </button>
                        <a href="/organiser/settings" class="btn btn-outline-dark">
                            Site Settings
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-heading">
            <h2>Draft Events</h2>
        </div>
        <% if (draftEvents.length === 0) { %>
            <div class="alert alert-info">
                You do not have any draft events.
            </div>
        <% } %>

        <div class="row g-3 mb-5">
            <% draftEvents.forEach(function(event) { %>
                <%- include("events/partials/event-card", {
                    event: event,
                    role: role,
                    actionText: "Manage Draft"
                }) %>
            <% }) %>
        </div>

        <%- include("events/partials/event-list",{
            publishedEvents: publishedEvents,
            role: role,
            actionText: "View Event Details"
        }) %>
    </main>
</body>
</html>
